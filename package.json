{
  "name": "plangate",
  "version": "0.1.0",
  "description": "Stops AI coding agents from running destructive cloud/infra changes by gating them on the real structured plan/diff/change-set, not the command text.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "plangate": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "agent",
    "claude-code",
    "terraform",
    "cloudformation",
    "aws",
    "azure",
    "kubernetes",
    "guardrail",
    "security",
    "devops"
  ],
  "dependencies": {
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.5.0",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
